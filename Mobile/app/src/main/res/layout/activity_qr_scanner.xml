<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Enhanced Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@drawable/toolbar_gradient_background"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
        android:elevation="8dp" />

    <!-- Camera Scanner -->
    <com.journeyapps.barcodescanner.DecoratedBarcodeView
        android:id="@+id/barcodeScanner"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomInstructionsCard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:zxing_scanner_layout="@layout/custom_barcode_scanner" />

    <!-- Scanning Overlay Frame -->
    <View
        android:id="@+id/scanningFrame"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:background="@drawable/scanning_frame_overlay"
        app:layout_constraintBottom_toBottomOf="@+id/barcodeScanner"
        app:layout_constraintEnd_toEndOf="@+id/barcodeScanner"
        app:layout_constraintStart_toStartOf="@+id/barcodeScanner"
        app:layout_constraintTop_toTopOf="@+id/barcodeScanner" />

    <!-- Top Status Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/topStatusCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="12dp"
        app:cardElevation="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_qr_scanner"
                android:tint="@color/primary_color"
                android:layout_marginEnd="12dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="QR Code Scanner"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/scannerStatusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Point camera at QR code"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <!-- Scanning Animation Indicator -->
            <View
                android:id="@+id/scanningIndicator"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:background="@drawable/scanning_pulse_indicator"
                android:visibility="visible" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- Bottom Instructions Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/bottomInstructionsCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        app:cardBackgroundColor="@color/card_background_overlay"
        app:cardCornerRadius="16dp"
        app:cardElevation="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_help_info"
                    android:tint="@color/accent_color"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Instructions"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Position the QR code within the scanning frame\n• Ensure good lighting for better scanning\n• Hold steady until the code is recognized"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingExtra="2dp" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- Corner Indicators for Scanning Frame -->
    <ImageView
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/scan_corner_top_left"
        android:tint="@color/primary_color"
        app:layout_constraintStart_toStartOf="@+id/scanningFrame"
        app:layout_constraintTop_toTopOf="@+id/scanningFrame" />

    <ImageView
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/scan_corner_top_right"
        android:tint="@color/primary_color"
        app:layout_constraintEnd_toEndOf="@+id/scanningFrame"
        app:layout_constraintTop_toTopOf="@+id/scanningFrame" />

    <ImageView
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/scan_corner_bottom_left"
        android:tint="@color/primary_color"
        app:layout_constraintBottom_toBottomOf="@+id/scanningFrame"
        app:layout_constraintStart_toStartOf="@+id/scanningFrame" />

    <ImageView
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/scan_corner_bottom_right"
        android:tint="@color/primary_color"
        app:layout_constraintBottom_toBottomOf="@+id/scanningFrame"
        app:layout_constraintEnd_toEndOf="@+id/scanningFrame" />

</androidx.constraintlayout.widget.ConstraintLayout>