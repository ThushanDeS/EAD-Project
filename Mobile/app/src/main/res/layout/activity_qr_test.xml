<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="QR Code Test"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Test the booking details screen with a sample QR code"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/buttonTestQR"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Test QR Code Display"
        android:backgroundTint="@color/primary_color"
        android:textColor="@android:color/white"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/buttonDebugQR"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Debug QR Generation"
        android:backgroundTint="@android:color/holo_orange_dark"
        android:textColor="@android:color/white" />
        android:textColor="@color/white"
        android:padding="16dp" />

</LinearLayout>