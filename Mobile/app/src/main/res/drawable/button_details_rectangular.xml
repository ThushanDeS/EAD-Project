<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#00796B" /> <!-- Darker teal when pressed -->
            <corners android:radius="4dp" /> <!-- Small border radius -->
        </shape>
    </item>
    
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#009688" /> <!-- Teal color -->
            <corners android:radius="4dp" /> <!-- Small border radius -->
        </shape>
    </item>
    
</selector>
